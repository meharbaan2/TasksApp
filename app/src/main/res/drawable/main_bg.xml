<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass morphism base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/aero_surface_start"
                android:centerColor="@color/aero_surface_mid"
                android:endColor="@color/aero_surface_end"
                android:angle="135" />
        </shape>
    </item>

    <!-- Frosted glass effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/aero_glass_highlight"
                android:endColor="#20FFFFFF"
                android:angle="90" />
        </shape>
    </item>

    <!-- Glass border with blur effect -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/aero_glass_border" />
        </shape>
    </item>
</layer-list>
